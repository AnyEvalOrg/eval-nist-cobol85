000400****************************************************************  SQ2014.2
000500*                                                              *  SQ2014.2
000600*    VALIDATION FOR:-                                          *  SQ2014.2
000700*    " HIGH       ".                                              SQ2014.2
000800*                                                              *  SQ2014.2
