038100     MOVE                  "M" TO M-AN-1.                         NC2154.2
038200     MOVE                  "N" TO N-AN-1.                         NC2154.2
038300 SEQ-TEST-GF-3.                                                   NC2154.2
038400     IF I-AN-1 = J-AN-1 AND K-AN-1 AND L-AN-1 AND M-AN-1          NC2154.2
